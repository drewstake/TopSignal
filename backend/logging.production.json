{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s",
      "()": "app.production_logging.SafeFormatter"
    },
    "access": {
      "format": "%(asctime)s %(levelname)s %(client_addr)s \"%(request_line)s\" %(status_code)s",
      "()": "app.production_logging.SafeAccessFormatter",
      "use_colors": false
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    },
    "rotating_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "backend/storage/logs/topsignal.log",
      "backupCount": 14,
      "encoding": "utf-8",
      "maxBytes": 10485760
    },
    "rotating_access_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "backend/storage/logs/access.log",
      "backupCount": 7,
      "encoding": "utf-8",
      "maxBytes": 10485760
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "console",
        "rotating_file"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "console",
        "rotating_file"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [
        "rotating_access_file"
      ],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": [
      "console",
      "rotating_file"
    ],
    "level": "INFO"
  }
}
