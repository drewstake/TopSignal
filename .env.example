# TopSignal environment profiles
#
# This file is a reference template.
# - Copy backend variables to: backend/.env
# - Copy frontend variables to: frontend/.env.local
# - Cloud mode does NOT require Docker.
# - Select one profile; do not copy this entire file (it contains duplicate keys).
# - For the Windows production task use TOPSIGNAL_ENV=production,
#   AUTH_REQUIRED=true, ALLOWED_ORIGINS=http://127.0.0.1:4173,
#   ALLOWED_ORIGIN_REGEX=, and ALLOW_LEGACY_PROJECTX_ENV_CREDENTIALS=false.
# - Keep both execution gates false for the initial unattended dry-run.
#   Restart/lease takeover disarms all provider-routing runs, including practice;
#   only dry-run runs auto-resume. See docs/windows-24x7-operations.md.

################################################################################
# Profile A: Cloud mode (no Docker required)
################################################################################

# Backend (.env)
DATABASE_URL=postgresql+psycopg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=<absolute-ca-file-path-url-encoded>
# Optional dedicated direct/session-mode URL for schema migrations. Never use
# the Supabase transaction pooler on port 6543 for migration locking.
MIGRATION_DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=<absolute-ca-file-path-url-encoded>
# Production remote PostgreSQL requires hostname-verified TLS and an explicit,
# readable CA file. Obtain the correct CA through your database provider's
# trusted channel; keep it in the immutable release. URL-encode spaces/path chars.
# The app forces gssencmode=disable; sslmode=require/prefer/verify-ca are rejected.
# Do not use host/hostaddr/service query overrides or ambient PGHOSTADDR/PGSERVICE.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional narrowing of the reviewed JWT algorithms (default: HS256,RS256,ES256).
SUPABASE_JWT_ALGORITHMS=HS256,RS256,ES256
AUTH_REQUIRED=true
ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGIN_REGEX=
# Required in cloud/non-local mode when storing per-user ProjectX credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your_fernet_key

PROJECTX_API_BASE_URL=https://api.topstepx.com
# Cloud users store their own encrypted ProjectX credentials through the app.
# Never fall back to one server-wide brokerage identity in an authenticated deployment.
ALLOW_LEGACY_PROJECTX_ENV_CREDENTIALS=false
# Disabled by default. Enabling this is only one of several required live-order gates.
TOPSIGNAL_LIVE_EXECUTION_ENABLED=false
# Recurring closed-candle worker. Enabling it does not enable live routing.
TOPSIGNAL_BOT_WORKER_ENABLED=false
TOPSIGNAL_BOT_WORKER_ALLOW_LIVE_EXECUTION=false
TOPSIGNAL_BOT_WORKER_POLL_SECONDS=5
TOPSIGNAL_BOT_CANDLE_CLOSE_GRACE_SECONDS=2
TOPSIGNAL_BOT_MAX_SCHEDULE_JITTER_SECONDS=3
TOPSIGNAL_BOT_WORKER_LEASE_TTL_SECONDS=45
TOPSIGNAL_BOT_WORKER_HEARTBEAT_SECONDS=10
TOPSIGNAL_BOT_PROVIDER_PROBE_SECONDS=60
TOPSIGNAL_BOT_MAX_RETRY_BACKOFF_SECONDS=300
# Tenant/account-scoped user hub. Never put access tokens in this URL.
PROJECTX_USER_HUB_URL=https://rtc.topstepx.com/hubs/user
# Process-global ProjectX user streaming is intentionally disabled. The bot
# worker creates demand-driven runtimes only for an authenticated user, owned
# account, and that user's credential-backed client factory.
PROJECTX_STREAMING_ENABLED=false
PROJECTX_INITIAL_LOOKBACK_DAYS=365
PROJECTX_SYNC_CHUNK_DAYS=90
PROJECTX_DAY_SYNC_LIMIT=1000
PROJECTX_YESTERDAY_REFRESH_MINUTES=180
PROJECTX_ACCOUNT_STALE_AFTER_SECONDS=900
# Apply migrations as a release step; deployed API replicas only verify/use the schema.
TOPSIGNAL_DB_SCHEMA_INIT=skip
BACKTEST_MAX_CONCURRENT_GLOBAL=2
BACKTEST_MAX_CONCURRENT_PER_USER=1
TOPSIGNAL_BACKTEST_MEMORY_BUDGET_BYTES=1610612736
TOPSIGNAL_BACKTEST_EVALUATOR_WORK_BUDGET=1000000000
TOPSIGNAL_BACKTEST_MAX_SERIES_POINTS=50000
# Local canonical Databento cache. Keep historical market data off Supabase.
TOPSIGNAL_DATABENTO_CACHE_DIR=backend/storage/databento
TOPSIGNAL_BACKTEST_CACHE_MAX_ENTRIES=8
TOPSIGNAL_BACKTEST_CACHE_MAX_BYTES=536870912
TOPSIGNAL_BACKTEST_PROXY_CACHE_ROWS=16384
TOPSIGNAL_BACKTEST_RESULT_CACHE_MAX_ENTRIES=8
TOPSIGNAL_BACKTEST_RESULT_CACHE_MAX_BYTES=268435456
# Optional local dev preferred backend port; falls forward if busy.
# TOPSIGNAL_DEV_BACKEND_PORT=8000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=0.75

# Frontend (.env.local)
VITE_API_BASE_URL=http://localhost:8000
# Optional: start the frontend in read-only demo mode with masked account, journal, and money fields.
VITE_DEMO_MODE=false
# Cloud profile must use your hosted Supabase URL, not localhost.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

################################################################################
# Profile B: Local mode (Docker required via Supabase CLI)
################################################################################

# 1) Install Supabase CLI
# 2) Start local stack: supabase start
# Explicitly identify local development when using loopback HTTP Supabase storage.
# Production credential-bearing storage requests require HTTPS.

# Backend (.env)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TOPSIGNAL_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
# Use local JWT secret from `supabase status` when validating local tokens.
SUPABASE_JWT_SECRET=your_local_supabase_jwt_secret
# Optional explicit local endpoints:
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=HS256
AUTH_REQUIRED=true

PROJECTX_API_BASE_URL=https://api.topstepx.com
# Use your TopstepX username plus the API key generated in TopstepX Settings -> API.
# ProjectX API Access must be subscribed and linked before loginKey authentication succeeds.
PROJECTX_USERNAME=your_topstepx_username
PROJECTX_API_KEY=your_topstepx_api_key
# Explicit single-user local-development escape hatch. The backend refuses this
# setting when either the database or Supabase runtime is cloud-hosted.
ALLOW_LEGACY_PROJECTX_ENV_CREDENTIALS=true
# Required if you store local credentials through the app instead of using the
# explicit legacy env variables above. Do not use a deterministic key for real credentials.
CREDENTIALS_ENCRYPTION_KEY=your_local_fernet_key
ALLOW_INSECURE_LOCAL_CREDENTIALS_KEY=false
# Disabled by default. Tests still prohibit live routing even if this is changed.
TOPSIGNAL_LIVE_EXECUTION_ENABLED=false
TOPSIGNAL_BOT_WORKER_ENABLED=false
TOPSIGNAL_BOT_WORKER_ALLOW_LIVE_EXECUTION=false
TOPSIGNAL_BOT_WORKER_POLL_SECONDS=5
TOPSIGNAL_BOT_CANDLE_CLOSE_GRACE_SECONDS=2
TOPSIGNAL_BOT_MAX_SCHEDULE_JITTER_SECONDS=3
TOPSIGNAL_BOT_WORKER_LEASE_TTL_SECONDS=45
TOPSIGNAL_BOT_WORKER_HEARTBEAT_SECONDS=10
TOPSIGNAL_BOT_PROVIDER_PROBE_SECONDS=60
TOPSIGNAL_BOT_MAX_RETRY_BACKOFF_SECONDS=300
PROJECTX_USER_HUB_URL=https://rtc.topstepx.com/hubs/user
# Keep disabled: environment-owned user hub state is not tenant safe. The bot
# worker creates explicit runtimes for one authenticated user/account pair.
PROJECTX_STREAMING_ENABLED=false
PROJECTX_INITIAL_LOOKBACK_DAYS=365
PROJECTX_SYNC_CHUNK_DAYS=90
PROJECTX_DAY_SYNC_LIMIT=1000
PROJECTX_YESTERDAY_REFRESH_MINUTES=180
PROJECTX_ACCOUNT_STALE_AFTER_SECONDS=900
TOPSIGNAL_DB_SCHEMA_INIT=full
BACKTEST_MAX_CONCURRENT_GLOBAL=2
BACKTEST_MAX_CONCURRENT_PER_USER=1
TOPSIGNAL_BACKTEST_MEMORY_BUDGET_BYTES=1610612736
TOPSIGNAL_BACKTEST_EVALUATOR_WORK_BUDGET=1000000000
TOPSIGNAL_BACKTEST_MAX_SERIES_POINTS=50000
# Local canonical Databento cache. Keep historical market data off Supabase.
TOPSIGNAL_DATABENTO_CACHE_DIR=backend/storage/databento
TOPSIGNAL_BACKTEST_CACHE_MAX_ENTRIES=8
TOPSIGNAL_BACKTEST_CACHE_MAX_BYTES=536870912
TOPSIGNAL_BACKTEST_PROXY_CACHE_ROWS=16384
TOPSIGNAL_BACKTEST_RESULT_CACHE_MAX_ENTRIES=8
TOPSIGNAL_BACKTEST_RESULT_CACHE_MAX_BYTES=268435456
# Optional local dev preferred backend port; falls forward if busy.
# TOPSIGNAL_DEV_BACKEND_PORT=8000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=0.75

# Frontend (.env.local)
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_local_supabase_anon_key
